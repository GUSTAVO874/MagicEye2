@page "/"
@using MagicEye2.RichUI.Service.IService
@using MagicEye2.RichUI.Models
@using Newtonsoft.Json;
@inject IMaestroTBeneficiario _maestroTBeneficiarioService

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<RadzenDataGrid Data="@maestrotbenef" TItem="MaestroTBeneficiarioDto"
                AllowFiltering="true" AllowColumnResize="true" AllowSorting="true"
                PageSize="5" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left"
                ShowPagingSummary="true" ColumnWidth="300px"
                SelectionMode="DataGridSelectionMode.Single" @bind-Value="@selectedBeneficiario">
    <Columns>
        <RadzenDataGridColumn TItem="MaestroTBeneficiarioDto" Property="MaestroTBeneficiarioId" Title="ID" Frozen="true" Width="80px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn TItem="MaestroTBeneficiarioDto" Property="Codigo" Title="Código" Width="160px" />
        <!-- Agrega más columnas según las propiedades de tu modelo -->
    </Columns>
</RadzenDataGrid>

Welcome to your new app.

@code {
    private IEnumerable<MaestroTBeneficiarioDto> maestrotbenef;
    private IList<MaestroTBeneficiarioDto> selectedBeneficiario;

    protected override async Task OnInitializedAsync()
    {
        ResponseDto? response = await _maestroTBeneficiarioService.GetAllMaestroTBeneficiariosAsync();

        if (response != null && response.IsSuccess)
        {
            var jsonData = JsonConvert.SerializeObject(response.Result);
            maestrotbenef = JsonConvert.DeserializeObject<List<MaestroTBeneficiarioDto>>(jsonData);
        }
        else
        {
            // Manejar el error
            maestrotbenef = new List<MaestroTBeneficiarioDto>();
        }

        // Inicializar la lista de seleccionados
        selectedBeneficiario = new List<MaestroTBeneficiarioDto>();

        // Si deseas seleccionar el primer elemento por defecto
        if (maestrotbenef.Any())
        {
            selectedBeneficiario.Add(maestrotbenef.First());
        }
    }
}
